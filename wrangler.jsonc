{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vector-conduccion",
  "main": "src/servidor.js",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SALAS", "class_name": "SalaOnline" }
    ]
  },
  "migrations": [
    { "tag": "crear-salas-v1", "new_sqlite_classes": ["SalaOnline"] }
  ]
}
